# Rendered by the nginx image at start-up (envsubst): ${API_UPSTREAM} is the Django API.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size 10m;

    include /etc/nginx/snippets/security-headers.conf;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;

    # API, uploads and Django admin go to the backend on the same origin.
    location ~ ^/(api|media|admin|static)/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Hashed build assets never change: cache for a year.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # The service worker and app shell must always be revalidated so updates reach users.
    location ~ ^/(sw\.js|workbox-.*\.js|index\.html|manifest\.webmanifest)$ {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # Client-side routes fall back to the app shell.
    location / {
        try_files $uri /index.html;
    }
}
