<?xml version="1.0" encoding="utf-8"?>
<!-- Never back up the encrypted session: its Keystore key cannot be restored on another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_session.xml" />
        <exclude domain="database" path="kakuma_resourcelink.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_session.xml" />
    </device-transfer>
</data-extraction-rules>
