# Copy to .env and fill in. Never commit real secrets.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# PostgreSQL (docker compose exposes it on 5432)
DATABASE_URL=postgres://kakuma:kakuma@localhost:5432/kakuma_resourcelink
POSTGRES_DB=kakuma_resourcelink
POSTGRES_USER=kakuma
POSTGRES_PASSWORD=kakuma

# React dev server
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Rate limits
THROTTLE_AUTH=10/min
THROTTLE_AI=20/hour

# Moderation
STORIES_REQUIRE_REVIEW=True
PROJECTS_REQUIRE_REVIEW=True

# Email (console backend prints reset links to the server log in development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
PASSWORD_RESET_URL=http://localhost:5173/reset-password?uid={uid}&token={token}

# AI assistant — server-side only. Without the key for the chosen provider the API returns 503 ai_unavailable.
# AI_PROVIDER: openai (ChatGPT models), anthropic (Claude) or ollama (local, no key). Set AI_MODEL to match.
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Only for AI_PROVIDER=ollama (e.g. AI_MODEL=qwen3:8b after `ollama pull qwen3:8b`)
OLLAMA_BASE_URL=http://localhost:11434/v1
AI_MODEL=gpt-6.2-sol
AI_EFFORT=medium
AI_ENABLE_FALLBACKS=True
AI_MAX_OUTPUT_TOKENS=8000
AI_HISTORY_MESSAGES=12
