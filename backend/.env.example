# Copy to .env and fill in. Never commit real secrets.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# PostgreSQL (docker compose exposes it on 5432)
DATABASE_URL=postgres://kakuma:kakuma@localhost:5432/kakuma_resourcelink
POSTGRES_DB=kakuma_resourcelink
POSTGRES_USER=kakuma
POSTGRES_PASSWORD=kakuma

# React dev server
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Rate limits
THROTTLE_AUTH=10/min
THROTTLE_AI=20/hour

# Moderation
STORIES_REQUIRE_REVIEW=True
PROJECTS_REQUIRE_REVIEW=True

# Email. The console backend prints emails (e.g. reset links) to the server log instead of sending them.
# To send real email through Gmail: turn on 2-Step Verification, create an app password at
# https://myaccount.google.com/apppasswords, then use the smtp backend and fill in the lines below.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
# The 16-character app password, not your normal Gmail password.
EMAIL_HOST_PASSWORD=
# Defaults to EMAIL_HOST_USER. Gmail only sends as your own address (or a verified alias).
DEFAULT_FROM_EMAIL=Kakuma ResourceLink <you@gmail.com>
# Password reset codes: minutes valid, wrong tries allowed, seconds before another code can be sent.
PASSWORD_RESET_CODE_MINUTES=15
PASSWORD_RESET_CODE_ATTEMPTS=5
PASSWORD_RESET_RESEND_SECONDS=60

# AI assistant — server-side only. Without the key for the chosen provider the API returns 503 ai_unavailable.
# AI_PROVIDER: openai (ChatGPT models), anthropic (Claude) or ollama (local, no key). Set AI_MODEL to match.
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Only for AI_PROVIDER=ollama (e.g. AI_MODEL=gemma3:12b after `ollama pull gemma3:12b`)
OLLAMA_BASE_URL=http://localhost:11434/v1
# Thinking makes local replies several times slower; keep_alive keeps the model loaded between messages.
OLLAMA_THINK=False
OLLAMA_KEEP_ALIVE=2h
OLLAMA_MAX_OUTPUT_TOKENS=1024
AI_MODEL=gpt-6.2-sol
AI_EFFORT=medium
AI_ENABLE_FALLBACKS=True
AI_MAX_OUTPUT_TOKENS=8000
AI_HISTORY_MESSAGES=12
